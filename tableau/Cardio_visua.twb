      <aliases enabled='yes' />
      <column aggregation='None' caption='Systolic Blood Pressure (mmHg)' datatype='integer' name='[Ap Hi (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[ap_hi]' peg='0' size='10' />
      </column>
      <column aggregation='None' caption='Diastolic Blood Pressure(10 mmHg bins)' datatype='integer' name='[Ap Lo (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[ap_lo]' peg='0' size='10' />
      </column>
      <column caption='CVD Rate' datatype='real' name='[Calculation_0329054858022913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [cardio] = &quot;CVD&quot; THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/COUNT([cardio])' />
      </column>
      <column caption='Donut' datatype='integer' name='[Calculation_0598990718443521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='cardio_visualisation(in).csv' datatype='table' name='[__tableau_internal_object_id__].[cardio_visualisation(in).csv_D9DDDDB944B44C429F41F22CFCD2BACD]' role='measure' type='quantitative' />
      <column caption='Physical Activity status' datatype='string' name='[active]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;No&quot;' value='Physically Inactive' />
          <alias key='&quot;Yes&quot;' value='Physically Active' />
        </aliases>
      </column>
